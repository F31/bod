    }
  },
  "info": {
    "description": "本机控制面（/_bod/*）与产品接口（/api/v1/*）的同一份契约。文档由路由表与 DTO 生成，不手写。`x-bod-status=planned` 表示路径已冻结、实现未落地，请求会得到 501。",
    "title": "bod 控制面与产品接口",
    "version": "bod-host/v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/_bod/events": {
      "get": {
        "description": "令牌在 Authorization 头；额外拒绝查询串令牌与非法游标，需按原因分别说明",
        "operationId": "get_bod_events",
        "parameters": [
          {
            "description": "起始游标；同时带 Last-Event-ID 头时以头为准",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "`0` 表示只回放历史不跟随；缺省跟随",
            "in": "query",
            "name": "follow",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "单次连接最长毫秒数，缺省 30000，夹在 100..=60000",
            "in": "query",
            "name": "max_ms",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "心跳间隔毫秒，缺省 1000，夹在 20..=10000",
            "in": "query",
            "name": "heartbeat_ms",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "SSE 帧流；鉴权失败时先回 401 再断开，不会以流内事件表达错误"
          },
          "401": {
            "content": {
              "application/json": {
                "example": {
                  "error": "BOD_STREAM_DENIED"
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "未通过鉴权；`error` 为本端点固定的拒绝码，客户端按码分支"
          },
          "404": {
            "content": {
              "application/json": {
                "example": {
                  "error": "BOD_NOT_FOUND"
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "路径不存在或方法不匹配；两者对外同答 404"
          }
        },
        "summary": "订阅事件流（SSE）",
        "x-bod-auth": "in-handler",
        "x-bod-status": "served"
      }
    },
